@page "/login"
@attribute [AllowAnonymous]
@inject NavigationManager Nav
@inject IConfiguration Config
@using System.Security.Claims;
@using System.ComponentModel.DataAnnotations;

<div class="d-flex justify-content-center align-items-center" style="height:80vh;">
    <div class="card shadow p-4" style="width: 480px;">
        <!-- Avatar Icon -->
        <div class="text-center mb-1">
            <i class="bi bi-person-circle text-primary" style="font-size: 64px;"></i>
        </div>
        <h3 class="text-center mb-2 text-dark fw-bold">LOGIN</h3>

        <EditForm Model="@loginModel"
                  OnValidSubmit="@SubmitLogin"
                  FormName="LoginForm">

            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label fw-semibold">Username</label>
                <InputText class="form-control modern-input" @bind-Value="loginModel.Username" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Password</label>
                <InputText class="form-control modern-input" type="password"
                           @bind-Value="loginModel.Password" />
            </div>

            <ValidationSummary />

            <button type="submit" class="btn btn-primary w-100 mt-2 login-btn">Login</button>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger mt-3">@error</div>
            }
        </EditForm>
    </div>
</div>

@code {

    [CascadingParameter]
    public HttpContext? ctx { get; set; }

    [SupplyParameterFromForm]
    public LoginModel loginModel { get; set; } = new();

    private string error = "";

    private async Task SubmitLogin()
    {
        var user = (loginModel.Username ?? "").Trim();
        var pass = (loginModel.Password ?? "").Trim();

        var expectedUser = Config["AuthSettings:Username"];
        var expectedPass = Config["AuthSettings:Password"];
        var expectedRole = Config["AuthSettings:Role"];

        if (user != expectedUser || pass != expectedPass)
        {
            error = "Invalid username or password.";
            return;
        }

        var claims = new List<Claim>
        {
            new Claim(ClaimTypes.Name, user),
            new Claim(ClaimTypes.Role, expectedRole ?? "User")
        };

        var claimsIdentity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);

        var principal = new ClaimsPrincipal(claimsIdentity);

        await ctx!.SignInAsync(principal);

        Nav.NavigateTo("/", true);
    }

    public class LoginModel
    {
        [Required(AllowEmptyStrings = false, ErrorMessage ="Please provide the user name")]
        public string? Username { get; set; }
        [Required(AllowEmptyStrings = false, ErrorMessage = "Please provide the password")]
        public string? Password { get; set; }
    }
}

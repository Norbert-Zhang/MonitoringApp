@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                @* <NotAuthorized>
                    <a href="/login">Login</a>
                </NotAuthorized> *@
                <Authorized>
                    <a href="/logout" class="logout-link btn btn-outline-light btn-sm d-flex align-items-center">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
